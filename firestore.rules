rules_version = '2';
// Paste into Firebase Console > Firestore Database > Rules > Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin()  { return signedIn() && request.auth.token.email == 'trunghieuhvtc@gmail.com'; }
    function isStaff()  {
      return isAdmin() || (signedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.token.email)));
    }

    // Public hooks: anyone reads published ones, staff manage
    match /hooks/{id} {
      allow read: if resource.data.published == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    // Music library for the editor: public read, staff write
    match /music/{id} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // VA allow-list: doc id = lowercase email. Only admin edits; staff can read.
    match /staff/{email} {
      allow read: if isStaff() || (signedIn() && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Per-user data (saved hooks, projects) for later phases
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
